  "type": "module",
  "description": "Web UI for the StepCode CLI: /ui command starts an ACP (Agent Client Protocol) bridge plus a React + TypeScript client that exposes the full CLI feature set.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "install:extension": "node scripts/install-extension.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "marked": "^16.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
